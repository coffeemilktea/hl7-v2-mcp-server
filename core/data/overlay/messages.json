        "rpt": 1
      },
      {
        "seg": "NK1",
        "req": "O",
        "rpt": "∞"
      },
      {
        "seg": "PV1",
        "req": "R",
        "rpt": 1
      },
      {
        "seg": "PV2",
        "req": "O",
        "rpt": 1
      },
      {
