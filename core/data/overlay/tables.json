  "0123": {
    "name": "Result Status - OBR",
    "note": "Applies to OBR-25 only. Do not confuse with table 0085 (OBX-11), which uses an overlapping but different code set — 0123 has no M, N, U or W.",
    "values": [
      {
        "code": "O",
        "desc": "Order received; specimen not yet received"
      },
      {
        "code": "I",
        "desc": "No results available; specimen received, procedure incomplete"
      },
      {
        "code": "S",
        "desc": "No results available; procedure scheduled, but not done"
      },
      {
        "code": "A",
        "desc": "Some, but not all, results available"
